# Domain whose A/AAAA record points at this server, e.g. tschuden.at
DOMAIN=
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=

# Generate every secret with: openssl rand -hex 32
# Use letters/digits only: they end up in the MongoDB URL and the S3 config JSON.
PAYLOAD_SECRET=

# Root account (only for admin tasks like backups; the app never uses it)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
# App account, created on the first start with readWrite on MONGO_DB only
MONGO_DB=portfolio
MONGO_USER=payload
MONGO_PASSWORD=

S3_BUCKET=portfolio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Contact form notifications via Resend (https://resend.com/api-keys); optional
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. kontakt@tschuden.at
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="Andreas Tschuden"
# Your inbox for contact form messages
CONTACT_TO_EMAIL=
