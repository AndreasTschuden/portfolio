DATABASE_URL=
PAYLOAD_SECRET=

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=

# Public site URL (used for OG/Twitter meta tags)
NEXT_PUBLIC_SITE_URL=

# Contact form notifications via Resend (leave RESEND_API_KEY empty to log emails to the console)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. kontakt@tschuden.at
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Where contact form messages go (no email is sent when empty)
CONTACT_TO_EMAIL=

# Optional: increases GitHub API rate limit from 60 to 5000 req/h
GITHUB_TOKEN=
