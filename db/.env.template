# Core images
MONGO_IMAGE=mongo:7
MONGO_EXPRESS_IMAGE=mongo-express:latest

# Container names
MONGO_CONTAINER_NAME=mongodb
MONGO_EXPRESS_CONTAINER_NAME=mongo-express

# Host ports
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8181

# MongoDB init credentials and default database
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_PASSWORD
MONGO_INITDB_DATABASE=myDB01

# App user created by mongo-init/init.js (readWrite on MONGO_APP_DB only)
MONGO_APP_DB=portfoliodb
MONGO_APP_USER=tschudea
MONGO_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# Mongo Express login in browser (set true for production)
ME_CONFIG_BASICAUTH=false
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=CHANGE_ME_STRONG_EXPRESS_PASSWORD
